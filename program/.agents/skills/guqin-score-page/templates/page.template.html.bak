<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>古琴跟谱 · @@TITLE@@</title><style>
:root{--desk:#2a2926;--bar:#1d1c1a;--bfg:#e9e4d8;--paper:#fbf9f1;--acc:#c2432f;--warn:#e4a032;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--desk:#d6d3ca;--bar:#efece3;--bfg:#222;color-scheme:light}}
:root[data-theme="light"]{--desk:#d6d3ca;--bar:#efece3;--bfg:#222;color-scheme:light}
html,body{height:100%;margin:0;background:var(--desk)}
body{display:flex;flex-direction:column;color:var(--bfg);font:15px/1.5 system-ui,-apple-system,"PingFang SC",sans-serif;overflow:hidden}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bar);z-index:20}
.top{display:flex;align-items:center;gap:8px;background:var(--bar);padding:6px 10px;z-index:6;flex-wrap:wrap}
#info{flex:1;min-width:140px;font-size:12.5px;opacity:.85}#info b{color:var(--warn)}
#meter{height:3px;background:#8884;border-radius:2px;margin-top:3px;overflow:hidden}#meter i{display:block;height:100%;width:0;background:var(--acc)}
.top label{font-size:12px;opacity:.85;display:flex;align-items:center;gap:4px}.top input[type=range]{width:74px}
button{font:inherit;color:var(--bfg);background:#8883;border:0;border-radius:10px;padding:8px 12px;min-height:44px}
button.p{background:var(--acc);color:#fff}
#sc{flex:1;overflow:auto;min-height:0;-webkit-overflow-scrolling:touch}
#paper{background:var(--paper);margin:10px;padding:8px 8px 20px;border-radius:3px;box-shadow:0 2px 16px #0007;position:relative;width:calc(var(--z,170)*1% - 20px)}
#paper h1{margin:6px 0 8px;font:600 22px "Songti SC","Noto Serif SC",serif;letter-spacing:.4em;color:#1b1b1b;text-align:center}
#paper h1 small{display:block;font:11px system-ui,sans-serif;letter-spacing:0;color:#777;margin-top:2px}
.rw{position:relative;margin:0 0 2px}.rw img,.rw canvas{display:block;width:100%;height:auto;mix-blend-mode:multiply}
.rl{display:flex;align-items:center;gap:8px;margin:10px 2px 2px;font:600 11px system-ui,sans-serif;color:#8a7f6a;letter-spacing:.08em}.rl::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,#c9bfa8,transparent)}
.rl:first-of-type{margin-top:2px}
#lensw{display:none;background:var(--paper);border-bottom:2px solid var(--acc);z-index:5;position:relative}
#lensw.on{display:block}
#lens{display:block;width:100%;height:26vh;min-height:110px;max-height:240px;mix-blend-mode:normal}
.mk{position:absolute;top:4%;height:92%;border-radius:6px;cursor:pointer;transition:background .15s}
.mk.done{background:#fbf9f1b8}
.mk.cur{background:color-mix(in srgb,var(--acc) 20%,transparent);box-shadow:0 0 0 2px var(--acc),0 0 12px 2px color-mix(in srgb,var(--acc) 45%,transparent)}
.mk.warn::after{content:"";position:absolute;left:4px;right:4px;top:48%;height:3px;border-radius:2px;background:var(--warn)}
.sd .mk::before{content:attr(data-d);position:absolute;top:-2px;left:2px;font:700 11px system-ui,sans-serif;color:#17703d;background:#fffd;border-radius:3px;padding:0 3px;z-index:2}
nav{display:flex;gap:8px;background:var(--bar);padding:8px 10px calc(8px + env(safe-area-inset-bottom,0px));z-index:6}
nav button{flex:1}
#exit{display:none;position:fixed;right:10px;top:calc(10px + env(safe-area-inset-top,0px));z-index:9;background:#000a;color:#fff;min-height:36px;padding:4px 12px}
.imm .top,.imm nav{display:none}.imm #exit{display:block}
dialog{border:0;border-radius:14px;background:var(--bar);color:var(--bfg);width:min(92vw,560px);padding:16px}dialog::backdrop{background:#0008}
textarea{width:100%;box-sizing:border-box;min-height:220px;background:#8882;color:inherit;border:0;border-radius:8px;padding:8px;font:13px/1.7 ui-monospace,monospace}
.hint{font-size:12px;opacity:.7;margin:6px 0}
</style></head><body>
<div class="top"><div id="info"><div id="pos"></div><div id="hear">麦克风未开启</div><div id="meter"><i></i></div></div>
<label>放大<input id="zoom" type="range" min="100" max="400" value="150"></label><label><input type="checkbox" id="enh" checked> 增强</label><label>墨色<input id="ink" type="range" min="0" max="10" value="5"></label><label><input type="checkbox" id="lensck"> 放大条</label><label>速度<input id="spd" type="range" min="40" max="150" value="100"></label>
<label><input type="checkbox" id="mt"> 节拍</label><label><input type="checkbox" id="sd"> 时值</label><label>灵敏<input id="sens" type="range" min="1" max="10" value="5"></label>
<button id="dur">改时值</button><button id="imm">沉浸</button><button id="mic" class="p">开始听音</button></div>
<div id="lensw"><canvas id="lens"></canvas></div>
<div id="sc"><div id="paper"><h1>@@TITLE@@<small>@@SUBTITLE@@</small></h1></div></div>
<nav><button id="rst">重来</button><button id="prev">◀</button><button id="play" class="p">▶ 模拟弹奏</button><button id="next">▶</button></nav>
<button id="exit">退出沉浸</button>
<dialog id="dlg"><b>每排速度和每个音的时值（四分音符 = 1）</b><div class="hint">一行对应谱上的一排，格式“速度: 时值 时值 …”。0.5 是八分，0.25 是十六分。休止符也占一个位置。</div><textarea id="dt" spellcheck="false"></textarea><div class="hint" id="dmsg"></div><div style="display:flex;gap:8px"><button id="dapply" class="p">应用</button><button id="dclose">关闭</button></div></dialog>
<script>const IMGS=@@IMGS@@;const CELLS=@@CELLS@@;
const $=s=>document.querySelector(s),NM=["C","C♯","D","D♯","E","F","F♯","G","G♯","A","A♯","B"];
let BPM=@@BPM@@;const ROWN=@@ROWN@@;
const DUR=CELLS.map(c=>c[4]);
let idx=0,hit=0,miss=0,warn=new Set(),mk=[],playing=false,srcs=[],tos=[];
const paper=$("#paper");
/* ---------- 图像增强：放大2倍 + 反锐化 + 色阶（墨更黑更实、纸更白） ---------- */
const SRC=[],ENH=[],RLB=[];
function boxBlur(a,W,H,r){const t=new Float32Array(a.length),o=new Float32Array(a.length),k=2*r+1;
  for(let y=0;y<H;y++){const b=y*W;let s=0;for(let x=-r;x<=r;x++)s+=a[b+Math.min(W-1,Math.max(0,x))];
    for(let x=0;x<W;x++){t[b+x]=s/k;s+=a[b+Math.min(W-1,x+r+1)]-a[b+Math.max(0,x-r)]}}
  for(let x=0;x<W;x++){let s=0;for(let y=-r;y<=r;y++)s+=t[Math.min(H-1,Math.max(0,y))*W+x];
    for(let y=0;y<H;y++){o[y*W+x]=s/k;s+=t[Math.min(H-1,y+r+1)*W+x]-t[Math.max(0,y-r)*W+x]}}
  return o}
function enhance(im,on,ink){const S=on?2:1,W=im.naturalWidth*S,H=im.naturalHeight*S,c=document.createElement("canvas");c.width=W;c.height=H;
  const g=c.getContext("2d",{willReadFrequently:true});g.imageSmoothingEnabled=true;g.imageSmoothingQuality="high";g.drawImage(im,0,0,W,H);
  if(!on)return c;
  const d=g.getImageData(0,0,W,H),p=d.data,n=W*H,gr=new Float32Array(n);
  for(let i=0;i<n;i++)gr[i]=.299*p[i*4]+.587*p[i*4+1]+.114*p[i*4+2];
  const bl=boxBlur(gr,W,H,2),lo=70+ink*10,hi=238;
  for(let i=0;i<n;i++){let s=gr[i]+1.5*(gr[i]-bl[i]);let v=(s-lo)/(hi-lo);v=v<0?0:v>1?1:v;v=v*v*(3-2*v);const q=v*255;p[i*4]=p[i*4+1]=p[i*4+2]=q;p[i*4+3]=255}
  g.putImageData(d,0,0);return c}
function rebuild(){const on=$("#enh").checked,ink=+$("#ink").value;
  SRC.forEach((im,i)=>{if(!im.naturalWidth)return;const c=enhance(im,on,ink),old=ENH[i];c.className="";if(old&&old.parentNode)old.parentNode.replaceChild(c,old);else rws[i].insertBefore(c,rws[i].firstChild);ENH[i]=c});lensDraw()}
IMGS.forEach((b,i)=>{const lb=document.createElement("div");lb.className="rl";RLB.push(lb);paper.appendChild(lb);
  const r=document.createElement("div");r.className="rw";paper.appendChild(r);
  const im=new Image();SRC.push(im);im.onload=()=>{if(SRC.every(x=>x.complete&&x.naturalWidth))rebuild()};im.src="data:image/jpeg;base64,"+b});
const rws=[...document.querySelectorAll(".rw")];
CELLS.forEach((n,i)=>{const e=document.createElement("i");e.className="mk";e.style.left=n[2]+"%";e.style.width=n[3]+"%";e.dataset.i=i;rws[n[0]].appendChild(e);mk.push(e)});
const fmt=x=>({0.25:"¼",0.5:"½",0.75:"¾",1.5:"1½"})[x]||String(x);
function labels(){mk.forEach((e,i)=>e.dataset.d=CELLS[i][5]?"休"+fmt(DUR[i]):fmt(DUR[i]));RLB.forEach((l,r)=>l.textContent="第 "+(r+1)+" 排 · ♩="+BPM[r]+" · "+ROWN[r]+" 音")}labels();
/* 放大条：跟随当前音，显示该处局部放大图 */
function lensDraw(){const cv=$("#lens"),w=$("#lensw");if(!w.classList.contains("on"))return;
  const dp=window.devicePixelRatio||1,cw=cv.clientWidth,ch=cv.clientHeight;if(!cw)return;cv.width=Math.round(cw*dp);cv.height=Math.round(ch*dp);
  const g=cv.getContext("2d");g.fillStyle="#fbf9f1";g.fillRect(0,0,cv.width,cv.height);
  const c=CELLS[Math.min(idx,CELLS.length-1)],src=ENH[c[0]];if(!src)return;
  const cx=(c[2]+c[3]/2)/100*src.width,vw=Math.min(src.width,Math.max(src.height*cv.width/cv.height,src.width*.2));
  let x0=Math.max(0,Math.min(src.width-vw,cx-vw/2));const sc=cv.width/vw,dh=src.height*sc,dy=(cv.height-dh)/2;
  g.imageSmoothingQuality="high";g.drawImage(src,x0,0,vw,src.height,0,dy,cv.width,dh);
  g.strokeStyle="#c2432f";g.lineWidth=2*dp;g.fillStyle="rgba(194,67,47,.12)";
  const rx=(c[2]/100*src.width-x0)*sc,rw=c[3]/100*src.width*sc,ry=dy+src.height*.04*sc,rh=src.height*.92*sc;
  g.fillRect(rx,ry,rw,rh);g.strokeRect(rx,ry,rw,rh)}
function mark(){mk.forEach((e,k)=>{e.className="mk"+(k<idx?" done":k===idx?" cur":"")+(warn.has(k)?" warn":"")});lensDraw()}
function refresh(){$("#pos").innerHTML=idx<CELLS.length?`第 ${idx+1}/${CELLS.length} 个音 · 命中 ${hit} · <b>未匹配 ${miss}</b>`:`这一页弹完了 · 命中 ${hit} · 未匹配 ${miss}`}
function follow(){const e=mk[Math.min(idx,mk.length-1)],sc=$("#sc"),r=e.getBoundingClientRect(),s=sc.getBoundingClientRect();
  if(r.top<s.top+30||r.bottom>s.bottom-40||r.left<s.left+30||r.right>s.right-30)sc.scrollBy({left:r.left-s.left-s.width/2+r.width/2,top:r.top-s.top-s.height*.3,behavior:"smooth"})}
function setIdx(i,f=true){idx=Math.max(0,Math.min(CELLS.length,i));mark();refresh();if(f)follow()}
/* ---------- 音高：按旋律走向选八度 ---------- */
const MIDI=[];{let pv=50;CELLS.forEach(c=>{const p=c[1];if(!p.length){MIDI.push([]);return}
  let best=null;for(let m=40;m<=70;m++){if(((m%12)+12)%12===p[0]){const d=Math.abs(m-pv)+Math.max(0,Math.abs(m-52)-8)*.5;if(best===null||d<best.d)best={m,d}}}
  const ms=[best.m];for(let k=1;k<p.length;k++){let dd=(p[0]-p[k]+12)%12;if(!dd)dd=12;ms.push(best.m-dd)}MIDI.push(ms);pv=best.m})}
/* ---------- 古琴音色：Karplus-Strong 拨弦 + 低通 + 房间混响 ---------- */
let actx,out,cache={};
function ctx(){if(!actx){actx=new (window.AudioContext||window.webkitAudioContext)();
  const lp=actx.createBiquadFilter();lp.type="lowpass";lp.frequency.value=3200;lp.Q.value=.4;
  const body=actx.createBiquadFilter();body.type="peaking";body.frequency.value=180;body.gain.value=4;body.Q.value=.8;
  const g=actx.createGain();g.gain.value=.8;lp.connect(body);body.connect(g);g.connect(actx.destination);
  const conv=actx.createConvolver(),L=actx.sampleRate*1.4|0,ir=actx.createBuffer(2,L,actx.sampleRate);
  for(let c=0;c<2;c++){const d=ir.getChannelData(c);for(let i=0;i<L;i++)d[i]=(Math.random()*2-1)*Math.exp(-i/(actx.sampleRate*.28))}
  conv.buffer=ir;const wet=actx.createGain();wet.gain.value=.16;lp.connect(conv);conv.connect(wet);wet.connect(actx.destination);out=lp}
  if(actx.state==="suspended")actx.resume();return actx}
function ks(m){if(cache[m])return cache[m];const a=ctx(),fs=a.sampleRate,f=440*Math.pow(2,(m-69)/12),L=(fs*(m<46?7:5.5))|0,P=fs/f;
  const N=Math.max(2,Math.floor(P-.5)),dl=P-N-.5,C=(1-dl)/(1+dl),ring=new Float32Array(N);let s=0;
  for(let i=0;i<N;i++){s=.62*s+.38*(Math.random()*2-1);ring[i]=s}
  const o=new Float32Array(L),g=m<46?.9972:m<58?.9962:.9945;let p=0,prev=0,ax=0,ay=0;
  for(let n=0;n<L;n++){const cur=ring[p],v=g*.5*(cur+prev);prev=cur;const y=C*v+ax-C*ay;ax=v;ay=y;ring[p]=y;o[n]=cur;if(++p>=N)p=0}
  let mx=0;for(let i=0;i<L;i++)mx=Math.max(mx,Math.abs(o[i]));const k=.8/(mx||1),at=Math.floor(fs*.004);
  for(let i=0;i<L;i++)o[i]*=k*(i<at?i/at:1)*(i>L-fs*.5?(L-i)/(fs*.5):1);
  const b=a.createBuffer(1,L,fs);b.copyToChannel(o,0);return cache[m]=b}
function pluck(m,when,v){const a=ctx(),s=a.createBufferSource(),g=a.createGain();s.buffer=ks(m);g.gain.value=v;s.connect(g);g.connect(out);s.start(when);srcs.push(s)}
function click(when){const a=ctx(),o=a.createOscillator(),g=a.createGain();o.frequency.value=1700;g.gain.setValueAtTime(.001,when);g.gain.linearRampToValueAtTime(.12,when+.002);g.gain.exponentialRampToValueAtTime(.001,when+.05);o.connect(g);g.connect(a.destination);o.start(when);o.stop(when+.06);srcs.push(o)}
/* ---------- 模拟弹奏：整页提前排程，节奏由音频时钟决定 ---------- */
function timeline(){const spd=+$("#spd").value/100,T=[],clicks=[];let acc=0;
  for(let r=0;r<BPM.length;r++){const bm=60000/(BPM[r]*spd);let u=0;
    CELLS.forEach((c,i)=>{if(c[0]===r){T[i]=acc+u*bm;u+=DUR[i]}});
    for(let k=0;k<Math.ceil(u-1e-6);k++)clicks.push(acc+k*bm);acc+=u*bm}
  return{T,clicks,end:acc}}
function simStop(){playing=false;srcs.forEach(s=>{try{s.stop()}catch(e){}});srcs=[];tos.forEach(clearTimeout);tos=[];$("#play").textContent="▶ 模拟弹奏"}
function simStart(){if(timer)stopMic();if(idx>=CELLS.length)idx=0;const a=ctx();playing=true;$("#play").textContent="⏸ 暂停";
  const {T,clicks,end}=timeline(),s=idx,t0=a.currentTime+.15,base=T[s],spd=+$("#spd").value/100;
  CELLS.forEach((c,i)=>{if(i<s)return;const w=t0+(T[i]-base)/1000;
    MIDI[i].forEach((m,k)=>pluck(m,w,k?.7:1));tos.push(setTimeout(()=>{if(playing)setIdx(i)},150+T[i]-base))});
  if($("#mt").checked)clicks.forEach(t=>{if(t>=base-1e-6)click(t0+(t-base)/1000)});
  tos.push(setTimeout(()=>{simStop();setIdx(CELLS.length)},150+end-base+300))}
$("#play").onclick=()=>playing?simStop():simStart();
/* ---------- 麦克风跟随（和之前一样，和弦任意一个音对上即可） ---------- */
function yin(b,sr){const N=2048,maxT=Math.min(N-1,Math.floor(sr/55)),minT=Math.floor(sr/1200),d=new Float32Array(maxT+2),c=new Float32Array(maxT+2);
  for(let t=1;t<=maxT;t++){let s=0;for(let i=0;i<N;i++){const x=b[i]-b[i+t];s+=x*x}d[t]=s}
  let run=0;for(let t=1;t<=maxT;t++){run+=d[t];c[t]=run?d[t]*t/run:1}
  for(let t=Math.max(2,minT);t<maxT;t++){if(c[t]<0.12){while(t+1<maxT&&c[t+1]<c[t])t++;
    const a=c[t-1],m=c[t],e=c[t+1],den=a-2*m+e,sh=den?(a-e)/(2*den):0;return sr/(t+sh)}}return -1}
let mac,an,stream,buf,timer,env=0,onsetT=0,hist=[],lastAdv=-1,lastMiss=0;
async function startMic(){simStop();try{stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false}});
  mac=new (window.AudioContext||window.webkitAudioContext)();await mac.resume();an=mac.createAnalyser();an.fftSize=4096;mac.createMediaStreamSource(stream).connect(an);buf=new Float32Array(4096);
  timer=setInterval(tick,50);$("#mic").textContent="停止听音";$("#hear").textContent="等待声音…"}
  catch(e){$("#hear").textContent="无法使用麦克风，请用按钮或点谱手动推进"}}
function stopMic(){clearInterval(timer);timer=0;try{stream&&stream.getTracks().forEach(t=>t.stop());mac&&mac.close()}catch(e){}
  $("#mic").textContent="开始听音";$("#hear").textContent="麦克风未开启";$("#meter i").style.width="0"}
function skipRest(){while(idx<CELLS.length&&CELLS[idx][5])idx++}
function tick(){an.getFloatTimeDomainData(buf);let s=0;for(let i=0;i<buf.length;i++)s+=buf[i]*buf[i];
  const rms=Math.sqrt(s/buf.length),gate=0.03/(+$("#sens").value);$("#meter i").style.width=Math.min(100,rms/gate*30)+"%";
  if(rms>gate&&rms>env*1.7)onsetT=performance.now();env=env*0.85+rms*0.15;
  if(rms<gate){hist=[];$("#hear").textContent="等待声音…";return}
  const f=yin(buf,mac.sampleRate);if(f<0){hist=[];return}
  const m=Math.round(69+12*Math.log2(f/440)),pc=((m%12)+12)%12;$("#hear").textContent="听到 "+NM[pc];
  hist.push(pc);if(hist.length>3)hist.shift();skipRest();
  if(hist.length<3||hist.some(p=>p!==pc)||idx>=CELLS.length)return;
  const now=performance.now(),fresh=now-onsetT<700;let j=-1,k=0,cnt=0;
  for(;idx+k<CELLS.length&&cnt<3;k++){const c=CELLS[idx+k];if(c[5])continue;if(c[1].includes(pc)){j=k;break}cnt++}
  if(j>=0){if((cnt>0||pc===lastAdv)&&!fresh)return;hit++;for(let q=0;q<j;q++)if(!CELLS[idx+q][5])warn.add(idx+q);lastAdv=pc;onsetT=0;hist=[];idx+=j+1;skipRest();setIdx(idx)}
  else if(fresh&&now-lastMiss>500){lastMiss=now;miss++;warn.add(idx);mark();refresh()}}
$("#mic").onclick=()=>timer?stopMic():startMic();
$("#prev").onclick=()=>{simStop();lastAdv=-1;setIdx(idx-1)};$("#next").onclick=()=>{simStop();setIdx(idx+1)};
$("#rst").onclick=()=>{simStop();idx=0;hit=miss=0;warn=new Set();lastAdv=-1;setIdx(0);$("#sc").scrollTo({top:0,left:0,behavior:"smooth"})};
paper.addEventListener("click",e=>{const g=e.target.closest(".mk");if(g){simStop();lastAdv=-1;warn.delete(+g.dataset.i);setIdx(+g.dataset.i,false)}});
let rbT;const rbDelay=()=>{clearTimeout(rbT);rbT=setTimeout(rebuild,120)};
$("#enh").onchange=rebuild;$("#ink").oninput=rbDelay;
$("#lensck").onchange=e=>{$("#lensw").classList.toggle("on",e.target.checked);lensDraw()};
addEventListener("resize",lensDraw);
$("#zoom").oninput=e=>document.documentElement.style.setProperty("--z",e.target.value);
$("#sd").onchange=e=>paper.classList.toggle("sd",e.target.checked);
$("#imm").onclick=()=>document.body.classList.add("imm");$("#exit").onclick=()=>document.body.classList.remove("imm");
/* ---------- 改时值 / 每排速度 ---------- */
$("#dur").onclick=()=>{let k=0;$("#dt").value=BPM.map((b,r)=>{const n=ROWN[r],s=b+": "+DUR.slice(k,k+n).join(" ");k+=n;return s}).join("\n");$("#dmsg").textContent="";$("#dlg").showModal()};
$("#dclose").onclick=()=>$("#dlg").close();
$("#dapply").onclick=()=>{const L=$("#dt").value.split("\n").map(s=>s.trim()).filter(Boolean);let ok=L.length===ROWN.length,nb=[],nd=[];
  if(ok)L.forEach((l,r)=>{const [b,rest]=l.split(":");const a=(rest||"").split(/\s+/).filter(Boolean).map(Number);if(!(+b>0)||a.length!==ROWN[r]||a.some(x=>!(x>0)))ok=false;nb.push(+b);nd.push(...a)});
  if(ok){BPM=nb;nd.forEach((x,i)=>DUR[i]=x);labels();$("#dlg").close()}else $("#dmsg").textContent="每行格式：速度: 时值…，行数 "+ROWN.length+"，每行个数要和谱上的音一致（"+ROWN.join("、")+"）"};
document.documentElement.style.setProperty("--z",$("#zoom").value);setIdx(0,false);
</script></body></html>
